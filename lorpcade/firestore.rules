rules_version = '2';

// LORPcade cloud saves. Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// There are no accounts: a save lives at  saves/{CODE}/games/{game}  and the 12-character sync code IS the key.
//   - Only documents under a well-formed code can be touched, and nobody can list /saves, so codes can't be browsed.
//   - A code is 12 symbols from a 32-symbol alphabet (60 bits), so it can't be guessed.
//   - Writes must have exactly the shape the games send, and nothing can be deleted from a client.
// Anyone who HAS a code can read and replace that code's saves. That is the intended trade-off (see instruction.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function codeOk(code) { return code.matches('^[2-9A-HJ-NP-Z]{12}$'); }
    function gameOk(game) { return game.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$'); }
    function shapeOk(d) {
      return d.keys().hasOnly(['v', 'at', 'dev', 'data'])
          && d.keys().hasAll(['v', 'at', 'dev', 'data'])
          && d.v == 1
          && d.at is int
          && d.dev is string && d.dev.size() <= 40
          && d.data is map && d.data.size() >= 1 && d.data.size() <= 16;
    }

    match /saves/{code}/games/{game} {
      allow get, list: if codeOk(code);
      allow create, update: if codeOk(code) && gameOk(game) && shapeOk(request.resource.data);
      allow delete: if false;
    }

    // everything else stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
